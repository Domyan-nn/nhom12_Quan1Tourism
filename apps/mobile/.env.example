# true: mock data; false: connect to the real backend.
EXPO_PUBLIC_USE_MOCK=true
# Leave empty to detect the Expo development host. For a physical phone, set
# http://<LAN-IP-of-backend>:8000/api and run the backend on 0.0.0.0.
EXPO_PUBLIC_API_BASE_URL=
# The current FastAPI uses v1.
EXPO_PUBLIC_API_STYLE=v1
